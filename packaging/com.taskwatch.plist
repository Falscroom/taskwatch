<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taskwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/taskwatch</string>
        <string>app</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Рестарт только после падения; чистый «Выйти» из меню отключает до следующего входа. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.config/taskwatch/taskwatch.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.config/taskwatch/taskwatch.log</string>
</dict>
</plist>
